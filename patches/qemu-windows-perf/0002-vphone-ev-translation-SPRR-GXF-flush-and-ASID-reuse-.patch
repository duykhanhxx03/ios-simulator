 /* List iterators for lists of tagged pointers in TranslationBlock. */
@@ -692,6 +693,7 @@ void tb_flush__exclusive_or_serial(void)
     tcg_region_reset_all();
     /* XXX: flush processor icache at this point if cache flush is expensive */
     qatomic_inc(&tb_ctx.tb_flush_count);
+    vphone_ev(VEV_TB_FLUSH);
 }
 
 static void do_tb_flush(CPUState *cpu, run_on_cpu_data tb_flush_count)
@@ -846,6 +848,7 @@ static void tb_jmp_cache_inval_tb(TranslationBlock *tb)
  */
 static void do_tb_phys_invalidate(TranslationBlock *tb, bool rm_from_page_list)
 {
+    vphone_ev(VEV_TB_INVAL);
     uint32_t h;
     tb_page_addr_t phys_pc;
     uint32_t orig_cflags = tb_cflags(tb);
diff --git a/accel/tcg/translate-all.c b/accel/tcg/translate-all.c
index 1fcbeb3..f54b776 100644
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -258,6 +258,76 @@ static int setjmp_gen_code(CPUArchState *env, TranslationBlock *tb,
 
 static TranslationBlock *tb_gen_code_inner(CPUState *cpu, TCGTBCPUState s);
 
+/*
+ * vphone diagnostic: has this guest physical PC been translated before, with
+ * the same flags (a translation thrown away and redone) or other ones (a
+ * variant)? Two open-addressing sets of 2^22 keys; full probes are not counted.
+ */
+#define VTB_BITS 22
+static uint64_t *vtb_pc, *vtb_key;
+
+static bool vtb_insert(uint64_t *tab, uint64_t key)
+{
+    uint64_t h = (key * 0x9e3779b97f4a7c15ull) >> (64 - VTB_BITS);
+
+    for (int i = 0; i < 32; i++, h = (h + 1) & ((1u << VTB_BITS) - 1)) {
+        uint64_t cur = qatomic_read(&tab[h]);
+
+        if (cur == key) {
+            return false;
+        }
+        if (cur == 0 && qatomic_cmpxchg(&tab[h], 0, key) == 0) {
+            return true;
+        }
+        if (qatomic_read(&tab[h]) == key) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void vtb_classify(TranslationBlock *tb, TCGTBCPUState s)
+{
+    tb_page_addr_t phys = tb_page_addr0(tb);
+    uint64_t k1, k2;
+
+    if (phys == -1) {
+        return;
+    }
+    if (unlikely(!qatomic_read(&vtb_pc))) {
+        uint64_t *a = g_new0(uint64_t, 1u << VTB_BITS);
+        uint64_t *b = g_new0(uint64_t, 1u << VTB_BITS);
+
+        if (qatomic_cmpxchg(&vtb_key, NULL, b) != NULL) {
+            g_free(b);
+        }
+        if (qatomic_cmpxchg(&vtb_pc, NULL, a) != NULL) {
+            g_free(a);
+        }
+        if (!qatomic_read(&vtb_key)) {
+            return;
+        }
+    }
+    k1 = ((uint64_t)phys | (s.pc & ~TARGET_PAGE_MASK)) + 1;
+    k2 = (k1 * 0xff51afd7ed558ccdull) ^ ((uint64_t)s.flags << 32 | s.cflags) ^
+         (s.cs_base * 0xc4ceb9fe1a85ec53ull);
+    k2 |= 1;
+    if (vtb_insert(vtb_pc, k1)) {
+        vtb_insert(vtb_key, k2);
+        vphone_ev(VEV_TB_FIRST);
+    } else if (vtb_insert(vtb_key, k2)) {
+        vphone_ev(VEV_TB_VARIANT);
+    } else {
+        vphone_ev(VEV_TB_SAMEKEY);
+        if (tb_page_addr1(tb) != -1) {
+            vphone_ev(VEV_TB_SAMEKEY_XPAGE);
+        }
+    }
+    if (tb_page_addr1(tb) != -1) {
+        vphone_ev(VEV_TB_XPAGE);
+    }
+}
+
 TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
 {
     if (unlikely(vphone_ev_on)) {
@@ -266,6 +336,12 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
 
         vphone_ev(VEV_TB_GEN);
         vphone_ev_add(VEV_TB_GEN_KCYC, (__builtin_ia32_rdtsc() - t0) / 1000);
+        if (tb) {
+            vtb_classify(tb, s);
+            if ((s.cflags & CF_COUNT_MASK) == 1) {
+                vphone_ev(VEV_TB_ONEINSN);
+            }
+        }
         return tb;
     }
     return tb_gen_code_inner(cpu, s);
@@ -543,6 +619,8 @@ static TranslationBlock *tb_gen_code_inner(CPUState *cpu, TCGTBCPUState s)
     if (unlikely(existing_tb != tb)) {
         uintptr_t orig_aligned = (uintptr_t)gen_code_buf;
 
+        vphone_ev(VEV_TB_RACE);
+
         orig_aligned -= ROUND_UP(sizeof(*tb), qemu_icache_linesize);
         qatomic_set(&tcg_ctx->code_gen_ptr, (void *)orig_aligned);
         tcg_tb_remove(tb);
diff --git a/include/qemu/vphone-ev.h b/include/qemu/vphone-ev.h
index 7dd31bd..a7986a8 100644
--- a/include/qemu/vphone-ev.h
+++ b/include/qemu/vphone-ev.h
@@ -2,7 +2,9 @@
  * vphone diagnostic (VPHONE_EVENT_STATS=<seconds>): per-second rates of guest events that
  * leave translated code (exceptions by kind, GXF enter/exit, ERET), TLB fills and flushes,
  * translations, MMIO and code-page writes. Each thread counts into its own array; a logger
- * thread prints the sums to stderr every <seconds>. Off by default: one predictable branch.
+ * thread prints the sums to stderr every <seconds>, as per-second rates rounded down (an event
+ * rarer than once per <seconds> shows as 0: use a longer period, or "info jit" for TB flushes).
+ * Off by default: one predictable branch.
  *
  * SPDX-License-Identifier: GPL-2.0-or-later
  */
@@ -19,7 +21,8 @@ enum {
     VEV_RANGE_FULL_SIZE, VEV_RANGE_FULL_LARGE, VEV_PAGE_FULL_LARGE,
     VEV_FLUSHIDX_ALL, VEV_FLUSHIDX_ONE, VEV_FLUSHIDX_OTHER, VEV_RANGE_BY_LOG,
     VEV_ASID_RECENT8, VEV_ASID_KEY_RECENT8, VEV_SPRR_EL0_FLUSH, VEV_SPRR_EL1_FLUSH,
-    VEV_GXF_ERET_FLUSH,
+    VEV_GXF_ERET_FLUSH, VEV_TB_FIRST, VEV_TB_SAMEKEY, VEV_TB_VARIANT,
+    VEV_TB_XPAGE, VEV_TB_SAMEKEY_XPAGE, VEV_TB_RACE, VEV_TB_ONEINSN, VEV_TB_INVAL, VEV_TB_INVAL_DMA, VEV_TB_FLUSH,
     /* TLB fills per (core mmu_idx & 31) * 2 + (address bit 63) */
     VEV_FILLX, VEV_FILLX_END = VEV_FILLX + 64,
     VEV_MAX = VEV_FILLX_END
diff --git a/system/physmem.c b/system/physmem.c
index aafd55e..de49176 100644
--- a/system/physmem.c
+++ b/system/physmem.c
@@ -18,6 +18,7 @@
  */
 
 #include "qemu/osdep.h"
