From ec0601785a6feb99a67d6661a99f4b5627f6ad3e Mon Sep 17 00:00:00 2001
From: virt-ios <virt-ios@localhost>
Date: Sat, 14 Nov 2026 12:31:00 +0700
Subject: [PATCH 1/5] Build on Windows (MSYS2 UCRT64)

dev-hid: CLOCK_MONOTONIC where there is no CLOCK_BOOTTIME (touch trace).
helper: the vphone-mark measurement is Linux-only (perf_event_open);
off elsewhere.
t8030: the graphics capture RAM dump seeks and writes where there is no
pwrite, in binary mode.

Verified: qemu-system-aarch64.exe links with lzfse, libpng and nettle
and lists the vresearch101 machine.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/arm/apple-silicon/t8030.c | 10 ++++++++++
 hw/usb/dev-hid.c             |  4 ++++
 target/arm/helper.c          | 14 ++++++++++++++
 3 files changed, 28 insertions(+)

diff --git a/hw/arm/apple-silicon/t8030.c b/hw/arm/apple-silicon/t8030.c
index f87189b..807b3c8 100644
--- a/hw/arm/apple-silicon/t8030.c
+++ b/hw/arm/apple-silicon/t8030.c
@@ -2500,7 +2500,11 @@ static void t8030_sgx_capture(T8030GfxRegFile *rf, const char *kind,
             g_file_set_contents(ta_path, (const char *)ta, 0x20000, NULL);
         }
     }
+#ifdef _WIN32
+    fd = open(ram_path, O_WRONLY | O_CREAT | O_TRUNC | O_BINARY, 0644);
+#else
     fd = open(ram_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+#endif
     if (fd < 0) {
         return;
     }
@@ -2509,7 +2513,13 @@ static void t8030_sgx_capture(T8030GfxRegFile *rf, const char *kind,
                                MEMTXATTRS_UNSPECIFIED, buf,
                                chunk) == MEMTX_OK &&
             !buffer_is_zero(buf, chunk) &&
+#ifdef _WIN32
+            /* No pwrite on Windows: seek (64-bit) and write. */
+            (_lseeki64(fd, (__int64)off, SEEK_SET) < 0 ||
+             write(fd, buf, chunk) != (int)chunk)) {
+#else
             pwrite(fd, buf, chunk, off) != (ssize_t)chunk) {
+#endif
             break;
         }
     }
diff --git a/hw/usb/dev-hid.c b/hw/usb/dev-hid.c
index 02e44ac..fb8f2d9 100644
--- a/hw/usb/dev-hid.c
+++ b/hw/usb/dev-hid.c
@@ -1041,7 +1041,11 @@ static int usb_hid_pointer_poll(USBHIDState *us, uint8_t *buf, int len)
         }
         if (on) {
             struct timespec ts;
+#ifdef CLOCK_BOOTTIME
             clock_gettime(CLOCK_BOOTTIME, &ts);
+#else
+            clock_gettime(CLOCK_MONOTONIC, &ts);   /* Windows/macOS hosts */
+#endif
             fprintf(stderr, "touchrep %" PRIu64 " btn %d x %d y %d\n",
                     (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec, tablet[0],
                     tablet[1] | (tablet[2] << 8), tablet[3] | (tablet[4] << 8));
diff --git a/target/arm/helper.c b/target/arm/helper.c
index 0e118aa..d8bd12d 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -2725,8 +2725,14 @@ static void vphone_asid_trace(CPUARMState *env, uint64_t value)
  * global totals. Work of every thread of the process, on any vCPU, kernel
  * work on its behalf included, is counted; other processes are not.
  */
+#ifdef __linux__
 #include <linux/perf_event.h>
 #include <sys/syscall.h>
+#else
+/* No perf_event_open off Linux: the measurement is off (vphone_mark_on() is false). */
+#define PERF_COUNT_HW_INSTRUCTIONS 1
+#define PERF_COUNT_HW_CPU_CYCLES 0
+#endif
 
 static int vphone_mark_tracked = -1;    /* ASID, or -1 */
 static uint32_t vphone_mark_gen;
@@ -2747,8 +2753,12 @@ bool vphone_mark_on(void)
     static int on = -1;
 
     if (unlikely(on < 0)) {
+#ifdef __linux__
         const char *e = getenv("VPHONE_MARK");
         on = e && *e && atoi(e) != 0;
+#else
+        on = 0;
+#endif
         if (on) {
             qemu_mutex_init(&vphone_mark_lock);
         }
@@ -2758,6 +2768,9 @@ bool vphone_mark_on(void)
 
 static int vphone_mark_open(uint64_t pmu, uint64_t config, int group)
 {
+#ifndef __linux__
+    return -1;
+#else
     struct perf_event_attr a = {
         .size = sizeof(a),
         .type = PERF_TYPE_HARDWARE,
@@ -2767,6 +2780,7 @@ static int vphone_mark_open(uint64_t pmu, uint64_t config, int group)
         .read_format = PERF_FORMAT_GROUP,
     };
     return syscall(SYS_perf_event_open, &a, 0, -1, group, 0);
+#endif
 }
 
 static void vphone_mark_read(uint64_t v[3])
-- 
