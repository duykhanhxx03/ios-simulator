+    return file;
+#endif
     int fd = memory_region_get_fd(mr);
 
     if (fd >= 0 && qemu_ram_is_shared(rb) &&
diff --git a/include/system/hostmem-section.h b/include/system/hostmem-section.h
new file mode 100644
index 0000000..7726fd0
--- /dev/null
+++ b/include/system/hostmem-section.h
@@ -0,0 +1,18 @@
+/*
+ * memory-backend-section (Windows): guest RAM on a section other components map views of.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef SYSTEM_HOSTMEM_SECTION_H
+#define SYSTEM_HOSTMEM_SECTION_H
+
+#ifdef _WIN32
+/*
+ * The section behind `length` bytes of guest RAM at `host`, and the bytes' offset in it, where a
+ * memory-backend-section holds them all; false otherwise. The handle stays the backend's.
+ */
+bool qemu_win_section_lookup(const void *host, uint64_t length, HANDLE *section,
+                             uint64_t *offset);
+#endif
+
+#endif
