diff --git a/backends/hostmem-section.c b/backends/hostmem-section.c
new file mode 100644
index 0000000..a120ac9
--- /dev/null
+++ b/backends/hostmem-section.c
@@ -0,0 +1,182 @@
+/*
+ * QEMU host memory backend on a Windows section (pagefile-backed file mapping).
+ *
+ * memory-backend-section,id=ram,size=8G is guest RAM that another component can make views of:
+ * reims-vgpu (apple-gfx) maps views of the guest's pages from the section, as on Linux it maps
+ * them from memory-backend-memfd,share=on's memfd. The RAM is mapped at a 2 MiB-aligned address
+ * (a placeholder replaced by the view), and the backend registers (host address, size, section)
+ * so hw/display/apple-gfx.c can hand the section's HANDLE to the library in place of an fd
+ * (qemu_win_section_lookup).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "system/hostmem.h"
+#include "system/hostmem-section.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qemu/thread.h"
+#include "qom/object_interfaces.h"
+
+#define TYPE_MEMORY_BACKEND_SECTION "memory-backend-section"
+#define SECTION_ALIGN (2 * 1024 * 1024)
+
+#ifndef MEM_RESERVE_PLACEHOLDER
+#define MEM_RESERVE_PLACEHOLDER 0x00040000
+#endif
+#ifndef MEM_REPLACE_PLACEHOLDER
+#define MEM_REPLACE_PLACEHOLDER 0x00004000
+#endif
+#ifndef MEM_PRESERVE_PLACEHOLDER
+#define MEM_PRESERVE_PLACEHOLDER 0x00000002
+#endif
+
+typedef PVOID (WINAPI *VirtualAlloc2Fn)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, void *, ULONG);
+typedef PVOID (WINAPI *MapViewOfFile3Fn)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG,
+                                         void *, ULONG);
+
+/* The sections registered, for qemu_win_section_lookup. */
+typedef struct SectionRange {
+    uint8_t *host;
+    uint64_t size;
+    HANDLE section;
+} SectionRange;
+
+static QemuMutex ranges_lock;
+static GArray *ranges;
+
+static void ranges_init(void)
+{
+    static bool done;
+    if (!done) {
+        qemu_mutex_init(&ranges_lock);
+        ranges = g_array_new(false, false, sizeof(SectionRange));
+        done = true;
+    }
+}
+
+bool qemu_win_section_lookup(const void *host, uint64_t length, HANDLE *section,
+                             uint64_t *offset)
+{
+    bool found = false;
+    const uint8_t *p = host;
+
+    ranges_init();
+    qemu_mutex_lock(&ranges_lock);
+    for (guint i = 0; i < ranges->len; i++) {
+        SectionRange *r = &g_array_index(ranges, SectionRange, i);
+        if (p >= r->host && p + length <= r->host + r->size) {
+            *section = r->section;
+            *offset = p - r->host;
+            found = true;
+            break;
+        }
+    }
+    qemu_mutex_unlock(&ranges_lock);
+    return found;
+}
+
+/* `size` bytes of `section` at a 2 MiB-aligned address: a placeholder cut to the aligned piece,
+ * which the view replaces; the cut-off ends are given back. */
+static void *map_aligned(HANDLE section, uint64_t size, Error **errp)
+{
+    HMODULE kb = GetModuleHandleW(L"kernelbase.dll");
+    VirtualAlloc2Fn va2 = kb ? (VirtualAlloc2Fn)GetProcAddress(kb, "VirtualAlloc2") : NULL;
+    MapViewOfFile3Fn mvf3 = kb ? (MapViewOfFile3Fn)GetProcAddress(kb, "MapViewOfFile3") : NULL;
+    uint8_t *base, *at, *end;
+    void *view;
+
+    if (!va2 || !mvf3) {
+        error_setg(errp, "memory-backend-section needs Windows 10 1803 or later "
+                   "(VirtualAlloc2, MapViewOfFile3)");
+        return NULL;
+    }
+    base = va2(GetCurrentProcess(), NULL, size + SECTION_ALIGN,
+               MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS, NULL, 0);
+    if (!base) {
+        error_setg_win32(errp, GetLastError(), "cannot reserve guest RAM address space");
+        return NULL;
+    }
+    at = (uint8_t *)ROUND_UP((uintptr_t)base, SECTION_ALIGN);
+    end = base + size + SECTION_ALIGN;
+    if (at > base &&
+        !VirtualFree(base, at - base, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) {
+        goto split_failed;
+    }
+    if (at + size < end &&
+        !VirtualFree(at, size, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) {
+        goto split_failed;
+    }
+    view = mvf3(section, GetCurrentProcess(), at, 0, size, MEM_REPLACE_PLACEHOLDER,
+                PAGE_READWRITE, NULL, 0);
+    if (view != at) {
+        error_setg_win32(errp, GetLastError(), "cannot map the guest RAM section");
+        return NULL;
+    }
+    if (at > base) {
+        VirtualFree(base, 0, MEM_RELEASE);
+    }
+    if (at + size < end) {
+        VirtualFree(at + size, 0, MEM_RELEASE);
+    }
+    return at;
+
+split_failed:
+    error_setg_win32(errp, GetLastError(), "cannot split the guest RAM placeholder");
+    VirtualFree(base, 0, MEM_RELEASE);
+    return NULL;
+}
+
+static bool section_backend_memory_alloc(HostMemoryBackend *backend, Error **errp)
+{
+    g_autofree char *name = NULL;
+    HANDLE section;
+    void *host;
+    SectionRange r;
+
+    if (!backend->size) {
+        error_setg(errp, "can't create backend with size 0");
+        return false;
+    }
+    section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE | SEC_COMMIT,
+                                 (DWORD)(backend->size >> 32), (DWORD)backend->size, NULL);
+    if (!section) {
+        error_setg_win32(errp, GetLastError(), "cannot create the guest RAM section");
+        return false;
+    }
+    host = map_aligned(section, backend->size, errp);
+    if (!host) {
+        CloseHandle(section);
+        return false;
+    }
+    name = host_memory_backend_get_name(backend);
+    memory_region_init_ram_ptr(&backend->mr, OBJECT(backend), name, backend->size, host);
+
+    ranges_init();
+    r = (SectionRange){ .host = host, .size = backend->size, .section = section };
+    qemu_mutex_lock(&ranges_lock);
+    g_array_append_val(ranges, r);
+    qemu_mutex_unlock(&ranges_lock);
+    return true;
+}
+
+static void section_backend_class_init(ObjectClass *oc, const void *data)
+{
+    HostMemoryBackendClass *bc = MEMORY_BACKEND_CLASS(oc);
+
+    bc->alloc = section_backend_memory_alloc;
+}
+
+static const TypeInfo section_backend_info = {
+    .name = TYPE_MEMORY_BACKEND_SECTION,
+    .parent = TYPE_MEMORY_BACKEND,
+    .class_init = section_backend_class_init,
+};
+
+static void register_types(void)
+{
+    type_register_static(&section_backend_info);
+}
+
+type_init(register_types);
