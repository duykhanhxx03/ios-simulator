+++ b/crates/reims-vgpu-vulkan/src/os/windows/smoke.rs
@@ -0,0 +1,89 @@
+//! A smoke check of the Windows platform on the host's GPU, for a program to run where the
+//! crate's tests cannot build (core's testkit is Unix's): guest pages scattered in a view,
+//! imported into the GPU by pointer, written by the GPU, the writes seen in the guest's pages.
+
+use std::ptr::NonNull;
+
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::platform::os::vm::{HostAddr, HostVm as _};
+
+use super::*;
+
+const PAGE: u64 = 4096;
+
+fn fill(at: HostAddr, len: u64, byte: u8) {
+    // SAFETY: the smoke check's own writable pages.
+    unsafe { at.as_ptr::<u8>().write_bytes(byte, len as usize) };
+}
+
+fn byte(at: HostAddr) -> u8 {
+    // SAFETY: the smoke check's own readable pages.
+    unsafe { at.as_ptr::<u8>().read_volatile() }
+}
+
+/// Runs the check: its report lines, or why it failed.
+#[doc(hidden)]
+pub fn gpu_import_smoke() -> Result<Vec<String>, String> {
+    let mut report = Vec::new();
+
+    let device = rt::Device::system_default().map_err(|e| format!("no Vulkan device: {e:?}"))?;
+    report.push(format!("device: {}", device.properties().name));
+    learn_view_imports(&device);
+    let vm = WindowsVm::new();
+    let n = 64u64;
+    let guest = allocate_aliasable(n * PAGE).map_err(|e| format!("{e:?}"))?;
+    for i in 0..n {
+        fill(guest.wrapping_add(i * PAGE), PAGE, i as u8);
+    }
+    let view = vm.allocate_anywhere(n * PAGE).map_err(|e| format!("{e:?}"))?;
+    let runs: Vec<(HostAddr, u64)> = (0..n)
+        .map(|i| (guest.wrapping_add((n - 1 - i) * PAGE), PAGE))
+        .collect();
+    vm.remap_runs_shared_overwrite(view, &runs).map_err(|e| format!("{e:?}"))?;
+
+    let at = NonNull::new(view.as_ptr::<u8>()).ok_or("a null view")?;
+    let iv = import_view(at, n * PAGE);
+    if !(!iv.writes_kept()) { return Err("writable guest pages need no twin".into()); }
+    // SAFETY: the view stays mapped until after the buffer is released below.
+    let memory = unsafe { host_memory(iv.at(), false) };
+    let contents = rt::BufferContents::NoCopy {
+        memory,
+        deallocator: None,
+        keep_alive: None,
+    };
+    let copies_before = device.work_counts().copied_host_buffers_made;
+    let descriptor = rt::BufferDescriptor::new(n * PAGE, rt::ResourceOptions::shared(), contents)
+        .with_placement(rt::AddressPlacement::Outside);
+    let buffer = device.new_buffer_with_descriptor(descriptor).map_err(|e| format!("{e:?}"))?;
+    let copied = device.work_counts().copied_host_buffers_made > copies_before;
+    report.push(format!("imported by pointer: {}", !copied));
+
+    let queue = device.new_command_queue().map_err(|e| format!("{e:?}"))?;
+    let cb = queue.command_buffer().map_err(|e| format!("{e:?}"))?;
+    let mut blit = cb.blit_command_encoder().map_err(|e| format!("{e:?}"))?;
+    blit.fill_buffer(&buffer, 5 * PAGE..6 * PAGE, 0xAB).map_err(|e| format!("{e:?}"))?;
+    blit.fill_buffer(&buffer, 40 * PAGE + 16..40 * PAGE + 32, 0xCD).map_err(|e| format!("{e:?}"))?;
+    blit.end_encoding().map_err(|e| format!("{e:?}"))?;
+    cb.commit().map_err(|e| format!("{e:?}"))?;
+    cb.wait_until_completed().map_err(|e| format!("{e:?}"))?;
+
+    // View page i is guest page n-1-i.
+    let g5 = guest.wrapping_add((n - 1 - 5) * PAGE);
+    if (byte(g5), byte(g5.wrapping_add(PAGE - 1))) != (0xAB, 0xAB) { return Err(format!("bytes {:?} != {:?}", (byte(g5), byte(g5.wrapping_add(PAGE - 1))), (0xAB, 0xAB))); }
+    let g40 = guest.wrapping_add((n - 1 - 40) * PAGE);
+    if (byte(g40.wrapping_add(15)), byte(g40.wrapping_add(16)), byte(g40.wrapping_add(32))) != ((n - 1 - 40) as u8, 0xCD, (n - 1 - 40) as u8) { return Err(format!("bytes {:?} != {:?}", (byte(g40.wrapping_add(15)), byte(g40.wrapping_add(16)), byte(g40.wrapping_add(32))), ((n - 1 - 40) as u8, 0xCD, (n - 1 - 40) as u8))); }
+    let g4 = byte(guest.wrapping_add((n - 1 - 4) * PAGE));
+    if g4 != (n - 1 - 4) as u8 {
+        return Err(format!("an unwritten page changed: {g4:#x}"));
+    }
+    if copied {
+        return Err("the view was copied, not imported by pointer".into());
+    }
+    report.push("GPU writes landed in the scattered guest pages".into());
+
+    drop(buffer);
+    drop(iv);
+    vm.deallocate(view, n * PAGE);
+    vm.deallocate(guest, n * PAGE);
+    Ok(report)
+}
