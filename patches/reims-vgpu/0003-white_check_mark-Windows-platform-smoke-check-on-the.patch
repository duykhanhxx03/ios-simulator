new file mode 100644
index 00000000..6feaf6f2
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/os/windows/tests.rs
@@ -0,0 +1,82 @@
+//! The Windows platform's tests: the views of guest pages (`vm`, `files`) and their import into
+//! the GPU (`import`), on the host's Vulkan device. A test that needs a GPU skips where there is
+//! none (a CI runner without one).
+
+use std::ptr::NonNull;
+
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::platform::os::vm::{HostAddr, HostVm as _, KernReturn, VmProt};
+
+use super::*;
+
+/// One page of the host's.
+pub(crate) const PAGE: u64 = 4096;
+
+/// Whether the page at `at` is mapped and readable.
+pub(crate) fn mapped(at: HostAddr) -> bool {
+    winvm::readable(at.addr() as u64, 1)
+}
+
+/// Whether `len` bytes at `at` are mapped writable (`VirtualQuery`'s protection).
+pub(crate) fn writable(at: HostAddr, len: u64) -> bool {
+    use windows_sys::Win32::System::Memory::{MEMORY_BASIC_INFORMATION, VirtualQuery};
+    let mut cur = at.addr() as u64;
+    let end = cur + len.max(1);
+    while cur < end {
+        // SAFETY: a query of this process's address space into a valid out-structure.
+        let mut mbi: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+        let n = unsafe {
+            VirtualQuery(
+                std::ptr::with_exposed_provenance(cur as usize),
+                &mut mbi,
+                std::mem::size_of::<MEMORY_BASIC_INFORMATION>(),
+            )
+        };
+        // PAGE_READWRITE (4) or PAGE_WRITECOPY (8), committed (0x1000).
+        if n == 0 || mbi.State != 0x1000 || mbi.Protect & (0x04 | 0x08) == 0 {
+            return false;
+        }
+        cur = mbi.BaseAddress as u64 + mbi.RegionSize as u64;
+    }
+    true
+}
+
+fn fill(at: HostAddr, len: u64, byte: u8) {
+    // SAFETY: test-owned writable pages.
+    unsafe { at.as_ptr::<u8>().write_bytes(byte, len as usize) };
+}
+
+fn byte(at: HostAddr) -> u8 {
+    // SAFETY: test-owned readable page.
+    unsafe { at.as_ptr::<u8>().read_volatile() }
+}
+
+/// Mach's rules hold: a view of scattered pages aliases them both ways, a read-only protect is
+/// read-only, and a registered range (the guest's RAM) is not deallocated.
+#[test]
+fn views_alias_scattered_pages_as_machs_remap_does() {
+    let vm = WindowsVm::new();
+    assert_eq!(vm.page_size(), PAGE);
+    let n = 16u64;
+    let src = allocate_aliasable(n * PAGE).unwrap();
+    for i in 0..n {
+        fill(src.wrapping_add(i * PAGE), PAGE, 0x40 + i as u8);
+    }
+    let view = vm.allocate_anywhere(n * PAGE).unwrap();
+    let runs: Vec<(HostAddr, u64)> = (0..n)
+        .map(|i| (src.wrapping_add((n - 1 - i) * PAGE), PAGE))
+        .collect();
+    vm.remap_runs_shared_overwrite(view, &runs).unwrap();
+    for i in 0..n {
+        assert_eq!(byte(view.wrapping_add(i * PAGE)), 0x40 + (n - 1 - i) as u8);
+    }
+    fill(view.wrapping_add(3 * PAGE + 7), 1, 0xEE);
+    assert_eq!(byte(src.wrapping_add((n - 1 - 3) * PAGE + 7)), 0xEE);
+    vm.protect_max(view, PAGE, VmProt::READ).unwrap();
+    assert!(mapped(view) && !writable(view, PAGE));
+    assert!(writable(view.wrapping_add(PAGE), PAGE));
+    assert_eq!(vm.remap_shared_overwrite(view, view, 0), Err(KernReturn(4)));
+    assert!(vm.deallocate(view, n * PAGE).is_success());
+    assert!(vm.deallocate(src, n * PAGE).is_success());
+}
+
