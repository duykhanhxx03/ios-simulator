+#[test]
+fn private_memory_cannot_be_aliased() {
+    let a = allocate(2 * PAGE).unwrap();
+    let b = allocate(2 * PAGE).unwrap();
+    assert_eq!(remap_shared_overwrite(b, a, PAGE), Err(Kern::INVALID_ADDRESS));
+    deallocate(a, 2 * PAGE);
+    deallocate(b, 2 * PAGE);
+}
