+//! Threads on Windows: std's, named (SetThreadDescription, no 15-byte limit as Linux has) and
+//! sized; the FIFO hint Linux gives a display thread is a raised priority here
+//! (THREAD_PRIORITY_HIGHEST), and a worker runs at normal priority whatever spawned it.
+
+use std::sync::Arc;
+
+use reims_vgpu_core::platform::os::{Threads, TimerClock};
+use reims_vgpu_core::raise::death::{DeathId, DeathKind, fatal};
+use windows_sys::Win32::System::Threading::{
+    GetCurrentThread, SetThreadPriority, THREAD_PRIORITY_HIGHEST, THREAD_PRIORITY_NORMAL,
+};
+
+use super::clock::WindowsClock;
+
+fn set_priority(priority: i32) {
+    // SAFETY: the pseudo-handle of the calling thread.
+    unsafe { SetThreadPriority(GetCurrentThread(), priority) };
+}
+
+/// The calling thread presents frames: run it ahead of normal work.
+pub(crate) fn hint_fifo_thread() {
+    set_priority(THREAD_PRIORITY_HIGHEST);
+}
+
+/// The calling thread does ordinary work, whatever the thread that spawned it ran at.
+pub(crate) fn drop_inherited_hints() {
+    set_priority(THREAD_PRIORITY_NORMAL);
+}
+
+fn spawn_thread(name: &'static str, stack_size: usize, body: Box<dyn FnOnce() + Send>) {
+    let made = std::thread::Builder::new()
+        .name(name.to_owned())
+        .stack_size(stack_size)
+        .spawn(body);
+    if made.is_err() {
+        fatal(DeathId::Platform {
+            kind: DeathKind::Abort,
+            call: "CreateThread",
+        })
+    }
+}
+
+/// The threads; `without_hints` spawns every thread at normal priority.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct WindowsThreads {
+    without_hints: bool,
+}
+
+impl WindowsThreads {
+    /// Threads that take the display's priority hint.
+    pub fn new() -> WindowsThreads {
+        WindowsThreads::default()
+    }
+
+    /// Threads that take no hint.
+    pub fn without_hints() -> WindowsThreads {
+        WindowsThreads {
+            without_hints: true,
+        }
+    }
+}
+
+impl Threads for WindowsThreads {
+    fn spawn(&self, name: &'static str, stack_size: usize, body: Box<dyn FnOnce() + Send>) {
+        let fifo = !self.without_hints;
+        spawn_thread(
+            name,
+            stack_size,
+            Box::new(move || {
+                if fifo {
+                    hint_fifo_thread();
+                } else {
+                    drop_inherited_hints();
+                }
+                body();
+            }),
+        );
+    }
+
+    fn spawn_worker(&self, label: &'static str, body: Box<dyn FnOnce() + Send>) {
+        spawn_thread(
+            label,
+            reims_vgpu_core::rt::queue::WORKER_STACK,
+            Box::new(move || {
+                drop_inherited_hints();
+                body();
+            }),
+        );
+    }
+
+    fn give_fifo_hints(&self) {
+        hint_fifo_thread();
+    }
+
+    fn handle(&self) -> Arc<dyn Threads> {
+        Arc::new(*self)
+    }
+
+    fn timer_clock(&self) -> Option<Arc<dyn TimerClock>> {
+        Some(Arc::new(WindowsClock::new()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    use super::*;
+
+    const WAIT: Duration = Duration::from_secs(10);
+
+    /// A thread keeps its whole name and runs its body
+    #[test]
+    fn a_thread_is_named() {
+        let (tx, rx) = mpsc::channel();
+        WindowsThreads::new().spawn(
+            "reims-vgpu.display-present",
+            512 * 1024,
+            Box::new(move || {
+                tx.send(std::thread::current().name().map(str::to_owned)).unwrap();
+            }),
+        );
+        let name = rx.recv_timeout(WAIT).unwrap();
+        assert_eq!(name.as_deref(), Some("reims-vgpu.display-present"));
+    }
+}
diff --git a/crates/reims-vgpu-vulkan/src/os/windows/vm.rs b/crates/reims-vgpu-vulkan/src/os/windows/vm.rs
new file mode 100644
index 00000000..c19fc7b7
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/os/windows/vm.rs
@@ -0,0 +1,328 @@
+//! `HostVm` on Windows: Mach VM's calls, as core makes them, over placeholders (`winvm`).
+//!
+//! The model is Linux's (`os/linux/vm.rs`): a view of guest pages maps the *files* behind them
+//! again, from the backing table (`super::files`), and every range a view can be made of has a
+//! file. Here a file is a pagefile-backed section, and a mapping is a view of it replacing a piece
+//! of a placeholder (`MapViewOfFile3` with `MEM_REPLACE_PLACEHOLDER`), at page granularity; the
+//! address space core reserves is a placeholder region `winvm` tracks.
+//!
+//! What Linux needs and Windows does not: views through dma-bufs and their folding, and the views'
+//! budget against `vm.max_map_count` (Windows has no such limit; each run of a view of scattered
+//! guest pages is a view of its own). Measured (RTX 5060, driver 616.92, Windows 11,
+//! 2026-11-14): a 4 KiB remap takes 3 to 5 µs, and a range made of 16 such views imports into
+//! Vulkan by pointer (`VK_EXT_external_memory_host`).
+//!
+//! The page rules are Mach's, as Linux's module docs give them: `protect_max` and `deallocate`
+//! take every page the bytes touch; `allocate_fixed_overwrite` and `remap_shared_overwrite` take
+//! the length rounded up to whole pages from the page of the address. A call of no bytes changes
+//! nothing; the remap's is `KERN_INVALID_ARGUMENT`. `deallocate` leaves the pages reserved (no
+//! access) until the whole region is, then gives the address space back.
+
+use std::sync::Arc;
+
+use reims_vgpu_core::num::{ToU64, ToUsize};
+use reims_vgpu_core::platform::os::vm::{HostAddr, HostVm, KernReturn, VmProt};
+
+use super::files::{self, Backing, PROT_READ, PROT_WRITE};
+use crate::os::RamFile;
+
+const INVALID_ADDRESS: KernReturn = KernReturn(1);
+const NO_SPACE: KernReturn = KernReturn(3);
+const INVALID_ARGUMENT: KernReturn = KernReturn(4);
+
+fn kern(k: winvm::Kern) -> KernReturn {
+    KernReturn(k.0)
+}
+
+/// The host page size (4 KiB).
+pub(super) fn page_size() -> u64 {
+    winvm::page_size()
+}
+
+/// The whole pages `len` bytes at `addr` lie in: `protect_max` and `deallocate`.
+fn pages(addr: HostAddr, len: u64) -> Option<(u64, u64)> {
+    let mask = page_size() - 1;
+    let start = addr.addr().to_u64();
+    let first = start & !mask;
+    let end = start.checked_add(len)?.checked_add(mask)? & !mask;
+    Some((first, end - first))
+}
+
+/// The length rounded up to whole pages from the page of the address: `allocate_fixed_overwrite`
+/// and `remap_shared_overwrite`.
+fn length_pages(addr: HostAddr, len: u64) -> Option<(u64, u64)> {
+    let mask = page_size() - 1;
+    let first = addr.addr().to_u64() & !mask;
+    let length = len.checked_add(mask)? & !mask;
+    first.checked_add(length)?;
+    Some((first, length))
+}
+
+fn prot_of(bits: i32) -> winvm::Prot {
+    winvm::Prot::from_mach(bits)
+}
+
+/// A pointer to `at` in the process's address space.
+pub(super) fn ptr(at: u64) -> *mut std::ffi::c_void {
+    std::ptr::with_exposed_provenance_mut(at.to_usize())
+}
+
+/// `length` bytes of private zero-filled memory, read and write, at `at` (over what was there)
+/// or anywhere: its first byte. Private memory has no file, so no view can be made of it.
+pub(super) fn anonymous(at: Option<u64>, length: u64, what: &str) -> Result<u64, KernReturn> {
+    let made = match at {
+        Some(at) => winvm::allocate_fixed_overwrite(at, length).map(|()| at),
+        None => winvm::allocate(length),
+    };
+    made.map_err(|k| {
+        log::debug!(target: "reims_vgpu_vulkan::os", "{what}: {length:#x} bytes refused ({k:?})");
+        kern(k)
+    })
+}
+
+/// `length` bytes of `backing`'s section, with protection `prot`, at `at` (over what was there)
+/// or anywhere: its first byte.
+pub(super) fn file(
+    at: Option<u64>,
+    length: u64,
+    backing: &Backing,
+    prot: i32,
+) -> Result<u64, KernReturn> {
+    let at = match at {
+        Some(at) => at,
+        None => winvm::reserve(length).map_err(kern)?,
+    };
+    winvm::map_section(at, &backing.fd, backing.offset, length, prot_of(prot)).map_err(|k| {
+        log::debug!(
+            target: "reims_vgpu_vulkan::os",
+            "a view of guest pages: {length:#x} bytes at {at:#x} refused ({k:?})"
+        );
+        kern(k)
+    })?;
+    Ok(at)
+}
+
+/// A new section of `length` bytes of zeros: the file a range of the library's own is a view of.
+pub(crate) fn memfd(length: u64) -> Result<Arc<RamFile>, std::io::Error> {
+    winvm::Section::new(length)
+}
+
+/// A fresh range of `len` bytes, rounded up to whole pages, of zeros, that a view can be made of:
+/// a view of a section of its own, recorded in the backing table. Freed by `deallocate`.
+pub(crate) fn allocate_aliasable(len: u64) -> Result<HostAddr, KernReturn> {
+    let Some((_, length)) = pages(HostAddr::NULL, len) else {
+        return Err(NO_SPACE);
+    };
+    if length == 0 {
+        return Ok(HostAddr::NULL);
+    }
+    let fd = memfd(length).map_err(|_| NO_SPACE)?;
+    let backing = Backing { fd, offset: 0 };
+    let prot = PROT_READ | PROT_WRITE;
+    let at = file(None, length, &backing, prot)?;
+    files::record(at, length, backing, prot);
+    Ok(HostAddr::from_addr(at.to_usize()))
+}
+
+/// Memory of the library's own that a view can be made of and that only its holder frees: a view
+/// of a new section, registered in the backing table ([`files::Registration`]) so that
+/// `deallocate` refuses it. An IOSurface stand-in's memory.
+#[derive(Debug)]
+pub(crate) struct OwnMemory {
+    first: u64,
+    length: u64,
+    registration: Option<files::Registration>,
+}
+
+impl OwnMemory {
+    /// `len` bytes, rounded up to whole pages, of zeros; `None` for none, or where the host gives
+    /// no section or no address space, as an IOSurface's creation answers nil when memory runs
+    /// out.
+    pub(crate) fn new(len: u64) -> Option<OwnMemory> {
+        let (_, length) = pages(HostAddr::NULL, len)?;
+        if length == 0 {
+            return None;
+        }
+        let backing = Backing {
+            fd: memfd(length).ok()?,
+            offset: 0,
+        };
+        let first = file(None, length, &backing, PROT_READ | PROT_WRITE).ok()?;
+        Some(OwnMemory {
+            first,
+            length,
+            registration: Some(files::Registration::new(first, length, backing)),
+        })
+    }
+
+    /// The first byte.
+    pub(crate) fn first(&self) -> u64 {
+        self.first
+    }
+}
+
+impl Drop for OwnMemory {
+    /// Drops the registration, then the view.
+    fn drop(&mut self) {
+        drop(self.registration.take());
+        let _ = winvm::deallocate(self.first, self.length);
+    }
+}
+
+/// Maps `pieces`, which follow on from `target`, each from its section, and records them: all or
+/// nothing, the pieces mapped before a refusal put back as they were.
+fn map_view(target: u64, pieces: Vec<files::Piece>) -> Result<(), KernReturn> {
+    let before = files::pieces(target, pieces.iter().map(|p| p.at + p.length).max().unwrap_or(0));
+    for (done, piece) in pieces.iter().enumerate() {
+        if let Err(kr) = file(
+            Some(target + piece.at),
+            piece.length,
+            &piece.backing,
+            piece.prot,
+        ) {
+            put_back(target, before, pieces.iter().take(done));
+            return Err(kr);
+        }
+    }
+    files::record_pieces(target, pieces);
+    Ok(())
+}
+
+/// After a refused view: the pieces mapped before the refusal back as the target was (its
+/// pieces, from their sections), or reserved where it had no file (core's reservation).
+fn put_back<'a>(
+    target: u64,
+    before: Option<Vec<files::Piece>>,
+    mapped: impl Iterator<Item = &'a files::Piece>,
+) {
+    for piece in mapped {
+        let _ = winvm::deallocate(target + piece.at, piece.length);
+    }
+    if let Some(before) = before {
+        for p in before {
+            let _ = file(Some(target + p.at), p.length, &p.backing, p.prot);
+        }
+    }
+}
+
+/// No folding on Windows (Linux folds views into dma-bufs): an import's pages are always mapped
+/// from their sections.
+pub(crate) fn unfold(_first: u64, _end: u64) -> Result<(), u64> {
+    Ok(())
+}
+
+/// Runs `call`: Linux retries it after folding idle views when mappings run short; Windows has no
+/// such limit.
+pub(super) fn reclaiming<T>(mut call: impl FnMut() -> T) -> T {
+    call()
+}
+
+/// Mach VM's calls on Windows.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct WindowsVm;
+
+impl WindowsVm {
+    /// The calls.
+    pub fn new() -> WindowsVm {
+        WindowsVm
+    }
+
+    /// Whether every byte of `len` bytes at `addr` is readable: the backing table's answer where
+    /// it knows them all, and otherwise the OS's (`VirtualQuery`, through `winvm`).
+    pub fn readable(&self, addr: HostAddr, len: u64) -> bool {
+        let Some((first, length)) = pages(addr, len.max(1)) else {
+            return false;
+        };
+        files::readable(first, length).unwrap_or_else(|| winvm::readable(first, length))
+    }
+}
+
+impl HostVm for WindowsVm {
+    fn page_size(&self) -> u64 {
+        page_size()
+    }
+
+    fn page_shift(&self) -> u32 {
+        page_size().trailing_zeros()
+    }
+
+    /// Memory anywhere a view can be made of (as on Linux under vphone: an iOS guest's heaps over
+    /// task memory remap it); a length of 0 answers address 0, as Mach's does.
+    fn allocate_anywhere(&self, len: u64) -> Result<HostAddr, KernReturn> {
+        allocate_aliasable(len)
+    }
+
+    /// Fresh memory a view can be made of (a new section's) over the pages of the range's length
+    /// from the page of its address.
+    fn allocate_fixed_overwrite(&self, addr: HostAddr, len: u64) -> Result<(), KernReturn> {
+        let (first, length) = length_pages(addr, len).ok_or(NO_SPACE)?;
+        if length == 0 {
+            return Ok(());
+        }
+        let fd = memfd(length).map_err(|_| NO_SPACE)?;
+        let backing = Backing { fd, offset: 0 };
+        let prot = PROT_READ | PROT_WRITE;
+        file(Some(first), length, &backing, prot)?;
+        files::record(first, length, backing, prot);
+        Ok(())
+    }
+
+    /// The source's pages of the length, from the page of its first byte, mapped from their
+    /// sections over as many from `dst`'s page, each with the protection the source has there.
+    fn remap_shared_overwrite(
+        &self,
+        dst: HostAddr,
+        src: HostAddr,
+        len: u64,
+    ) -> Result<HostAddr, KernReturn> {
+        if len == 0 {
+            return Err(INVALID_ARGUMENT);
+        }
+        let (target, length) = length_pages(dst, len).ok_or(INVALID_ARGUMENT)?;
+        let (source, _) = length_pages(src, len).ok_or(INVALID_ADDRESS)?;
+        let Some(pieces) = files::pieces(source, length) else {
+            log::debug!(
+                target: "reims_vgpu_vulkan::os",
+                "remap of {length:#x} bytes at {source:#x}: no file behind them"
+            );
+            return Err(INVALID_ADDRESS);
+        };
+        map_view(target, pieces)?;
+        Ok(HostAddr::from_addr(target.to_usize()))
+    }
+
+    /// The protection of the range's pages; none for no bytes.
+    fn protect_max(&self, addr: HostAddr, len: u64, prot: VmProt) -> Result<(), KernReturn> {
+        if len == 0 {
+            return Ok(());
+        }
+        let (first, length) = pages(addr, len).ok_or(INVALID_ARGUMENT)?;
+        let bits = prot.raw() & (PROT_READ | PROT_WRITE);
+        if files::protected(first, length, bits) {
+            return Ok(());
+        }
+        winvm::protect(first, length, prot_of(bits)).map_err(kern)?;
+        files::protect(first, length, bits);
+        Ok(())
+    }
+
+    /// The range's pages back to reserved, showing no file from then on; none for no bytes. A
+    /// range of memory the library registered and does not own (the guest's RAM) is refused.
+    fn deallocate(&self, addr: HostAddr, len: u64) -> KernReturn {
+        if len == 0 {
+            return KernReturn::SUCCESS;
+        }
+        let Some((first, length)) = pages(addr, len) else {
+            return INVALID_ARGUMENT;
+        };
+        if files::meets_registration(first, length) {
+            log::error!(
+                target: "reims_vgpu_vulkan::os",
+                "deallocate of {length:#x} bytes at {first:#x}: registered memory, not unmapped"
+            );
+            return INVALID_ARGUMENT;
+        }
+        files::forget(first, length);
+        kern(winvm::deallocate(first, length))
+    }
+}
