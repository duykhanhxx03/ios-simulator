+#[test]
+fn allocate_is_zeroed_and_writable() {
+    let a = allocate(4 * PAGE).unwrap();
+    assert!((0..4 * PAGE).step_by(512).all(|o| byte(a + o) == 0));
+    fill(a, 4 * PAGE, 0x5a);
+    assert_eq!(byte(a + 4 * PAGE - 1), 0x5a);
+    assert_eq!(deallocate(a, 4 * PAGE), Kern::SUCCESS);
+}
