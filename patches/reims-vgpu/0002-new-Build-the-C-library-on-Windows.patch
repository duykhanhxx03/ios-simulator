@@ -0,0 +1,198 @@
+//! The reims-graphics device's C API on Windows: the same constants, types and functions as
+//! `graphics.rs`, so a host links unchanged, but no device. The device serves x86-64 macOS
+//! guests over a PCI BAR region and a doorbell fd (`reims-graphics`), which is Unix-only; vphone
+//! (`apple-gfx-mmio`) does not use it. `rvg_graphics_device_create` answers
+//! RVG_ERR_UNSUPPORTED, so no handle ever exists for the other functions.
+
+use std::ffi::c_void;
+
+use crate::device::{RvgMemoryMap, RvgMemoryRangeFile};
+use crate::sized::HostStruct;
+use crate::status::{RVG_ERR_UNSUPPORTED, RvgStatus};
+use crate::table::RvgDestroyFn;
+use crate::window::RvgWindowConfig;
+
+/// The PCI vendor ID of the graphics device: a placeholder until its own is picked.
+pub const RVG_GRAPHICS_PCI_VENDOR_ID: u16 = 0x1234;
+/// The PCI device ID of the graphics device: a placeholder, as the vendor ID is.
+pub const RVG_GRAPHICS_PCI_DEVICE_ID: u16 = 0x5247;
+/// The PCI class of the graphics device: a display controller of class "other".
+pub const RVG_GRAPHICS_PCI_CLASS: u16 = 0x0380;
+/// The BAR of the graphics device's registers.
+pub const RVG_GRAPHICS_PCI_BAR_REGISTERS: u32 = 0;
+/// The size of BAR 0.
+pub const RVG_GRAPHICS_REGISTERS_SIZE: u32 = 0x1000;
+/// Where in BAR 0 the MSI-X table starts.
+pub const RVG_GRAPHICS_MSIX_OFFSET: u32 = 0x800;
+/// The graphics device's MSI-X vectors.
+pub const RVG_GRAPHICS_MSIX_VECTORS: u32 = 1;
+/// The BAR of the graphics device's region.
+pub const RVG_GRAPHICS_PCI_BAR_REGION: u32 = 2;
+/// The register the guest writes a ring's id to as its doorbell.
+pub const RVG_GRAPHICS_REG_DOORBELL: u32 = 0x020;
+/// The control ring's id.
+pub const RVG_GRAPHICS_DOORBELL_CONTROL: u32 = 0;
+/// Where the guest's allocations start in the region.
+pub const RVG_GRAPHICS_ALLOCATIONS_OFFSET: u64 = 0x40_0000;
+
+/// `raise_interrupt(ctx, vector)`, as on Unix (never called here).
+pub type RvgGraphicsRaiseFn = Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, vector: u32)>;
+
+/// `scanout_written(ctx, offset, length)`, as on Unix (never called here).
+pub type RvgGraphicsScanoutWrittenFn =
+    Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, offset: u64, length: u64) -> bool>;
+
+/// The graphics device's callbacks, laid out as on Unix.
+#[repr(C)]
+#[derive(Clone, Copy)]
+#[expect(
+    missing_docs,
+    reason = "the fields' names say what they hold, as the header shows them"
+)]
+pub struct RvgGraphicsCallbacks {
+    /// sizeof(RvgGraphicsCallbacks) as the host was compiled.
+    pub struct_size: u32,
+    pub ctx: *mut c_void,
+    pub destroy: RvgDestroyFn,
+    pub raise_interrupt: RvgGraphicsRaiseFn,
+    pub scanout_written: RvgGraphicsScanoutWrittenFn,
+}
+
+// SAFETY: repr(C), a u32 first; a pointer and optional function pointers.
+unsafe impl HostStruct for RvgGraphicsCallbacks {}
+
+/// The graphics device's config, laid out as on Unix.
+#[repr(C)]
+#[derive(Clone, Copy)]
+#[expect(
+    missing_docs,
+    reason = "the fields' names say what they hold, as the header shows them"
+)]
+pub struct RvgGraphicsDeviceConfig {
+    /// sizeof(RvgGraphicsDeviceConfig) as the host was compiled.
+    pub struct_size: u32,
+    pub callbacks: *const RvgGraphicsCallbacks,
+    pub window: *const RvgWindowConfig,
+    pub memory_map: *const RvgMemoryMap,
+    pub memory_files: *const RvgMemoryRangeFile,
+}
+
+// SAFETY: repr(C), a u32 first; pointers.
+unsafe impl HostStruct for RvgGraphicsDeviceConfig {
+    const V1_SIZE: usize = 24;
+}
+
+/// The graphics device: none is ever made on Windows.
+pub struct RvgGraphicsDevice {
+    _none: std::convert::Infallible,
+}
+
+/// RVG_ERR_UNSUPPORTED on Windows, `*device` NULL where it is writable. The config is not read,
+/// so no table's destroy runs, as for a refusal before the tables are the library's.
+///
+/// # Safety
+/// `config` is NULL or a live config; `device` is NULL or writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_create(
+    _config: *const RvgGraphicsDeviceConfig,
+    device: *mut *mut RvgGraphicsDevice,
+) -> RvgStatus {
+    if !device.is_null() {
+        // SAFETY: the caller's contract: writable.
+        unsafe { device.write(std::ptr::null_mut()) };
+    }
+    RVG_ERR_UNSUPPORTED
+}
+
+/// Nothing to release: no device exists on Windows.
+///
+/// # Safety
+/// `device` is NULL (no handle is ever made here).
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_release(_device: *mut RvgGraphicsDevice) {}
+
+/// NULL, `*size` 0: no device exists on Windows.
+///
+/// # Safety
+/// `size` is NULL or writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_region(
+    _device: *const RvgGraphicsDevice,
+    size: *mut u64,
+) -> *mut c_void {
+    if !size.is_null() {
+        // SAFETY: the caller's contract: writable.
+        unsafe { size.write(0) };
+    }
+    std::ptr::null_mut()
+}
+
+/// 0: no device exists on Windows.
+///
+/// # Safety
+/// None: the handle is not read.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_mmio_read(
+    _device: *mut RvgGraphicsDevice,
+    _offset: u64,
+) -> u32 {
+    0
+}
+
+/// Nothing: no device exists on Windows.
+///
+/// # Safety
+/// None: the handle is not read.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_mmio_write(
+    _device: *mut RvgGraphicsDevice,
+    _offset: u64,
+    _value: u32,
+) {
+}
+
+/// Nothing: no device exists on Windows.
+///
+/// # Safety
+/// None: the handle is not read.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_mmio_write_taking(
+    _device: *mut RvgGraphicsDevice,
+    _offset: u64,
+    _value: u32,
+) {
+}
+
+/// RVG_ERR_UNSUPPORTED: no device exists on Windows.
+///
+/// # Safety
+/// None: the handle is not read.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_set_doorbell(
+    _device: *mut RvgGraphicsDevice,
+    _fd: i32,
+) -> RvgStatus {
+    RVG_ERR_UNSUPPORTED
+}
+
+/// Nothing: no device exists on Windows.
+///
+/// # Safety
+/// None: the handle is not read.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_reset(_device: *mut RvgGraphicsDevice) {}
+
+/// RVG_ERR_UNSUPPORTED: no device exists on Windows.
+///
+/// # Safety
+/// None: nothing is read or written.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_graphics_device_read_display(
+    _device: *mut RvgGraphicsDevice,
+    _dst: *mut u8,
+    _dst_length: usize,
+    _width: *mut u32,
+    _height: *mut u32,
+) -> RvgStatus {
+    RVG_ERR_UNSUPPORTED
+}
