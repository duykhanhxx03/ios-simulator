+/// The host's page size on Windows (`GetSystemInfo`): 4 KiB on x86-64.
+#[cfg(windows)]
+fn host_page_size() -> NonZeroU64 {
+    NonZeroU64::new(winvm::page_size()).unwrap_or(NonZeroU64::MIN)
