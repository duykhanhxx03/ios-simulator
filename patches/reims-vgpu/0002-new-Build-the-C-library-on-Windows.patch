+
+/// The size of the section whose handle `fd` holds, on Windows: no public call reads a section's
+/// size, so none is checked here (u64::MAX); a view past its end fails when it is mapped.
+#[cfg(windows)]
+#[expect(clippy::unnecessary_wraps, reason = "the Unix version's signature")]
+fn file_size(_fd: i32) -> std::io::Result<u64> {
+    Ok(u64::MAX)
+}
+
+/// A duplicate of the section handle `fd` holds (`DuplicateHandle`, same access, not inherited),
+/// which the map holds. On Windows a memory range file's `fd` is the section's HANDLE: Windows
+/// handles are 32-bit significant (sign-extended), so they fit the field (docs/api.md).
+#[cfg(windows)]
+fn duplicate(fd: i32) -> std::io::Result<winvm::Section> {
+    use windows_sys::Win32::Foundation::{DUPLICATE_SAME_ACCESS, DuplicateHandle, HANDLE};
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    // Sign-extended back to the pointer-sized handle, as WOW64's handle rules specify.
+    let source: HANDLE = std::ptr::without_provenance_mut(isize::try_from(fd).unwrap_or(-1).cast_unsigned());
+    let mut new: HANDLE = std::ptr::null_mut();
+    // SAFETY: duplicates a handle of this process into this process; an invalid handle is an
+    // error the call returns.
+    let ok = unsafe {
+        DuplicateHandle(
+            GetCurrentProcess(),
+            source,
+            GetCurrentProcess(),
+            &mut new,
+            0,
+            0,
+            DUPLICATE_SAME_ACCESS,
+        )
+    };
+    if ok == 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    // SAFETY: `new` is a section handle this call opened, owned by nothing else.
+    Ok(unsafe { winvm::Section::own_raw(new, u64::MAX) })
+}
