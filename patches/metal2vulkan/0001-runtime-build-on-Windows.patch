 impl Device {
+    /// The queue family the first move of an image over foreign (dma-buf) pages acquires it for:
+    /// the device's one family, or `VK_QUEUE_FAMILY_IGNORED` where its images are concurrent among
+    /// several (`sharing.rs`), as Vulkan has an acquire of such an image name it.
+    pub(super) fn foreign_acquirer(&self) -> u32 {
+        match &self.shared().queue_families[..] {
+            [family] => *family,
+            _ => vk::QUEUE_FAMILY_IGNORED,
+        }
+    }
+
     /// `registryID`: an identifier of the physical device, from its `deviceUUID`.
     pub fn registry_id(&self) -> u64 {
